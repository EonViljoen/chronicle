  "lore": [
    {
      "id": "undying-fire",
      "title": "The Undying Fire",
      "category": "Religions",
      "body": "The oldest faith of the realm holds that [[The First Fire]], lit at [[Emberfall]], is the world's heart, and that it will burn until the last age ends.[^1]\n\nIts priests became the [[Ashen Order]], who keep the flame and perform [[The Ashen Rite]] every hundred years.[^2]\n\n- **Symbol:** a ring of ash around a spark\n- **Holy place:** [[Emberfall]]",
      "sources": [
        "The Ember Chronicle, book I",
        "Sermons of the Ashen Rite"
      ]
    },
    {
      "id": "vale-tongue",
      "title": "Old Vale tongue",
      "category": "Languages",
      "body": "The speech of the first settlers of [[Brightvale]]. Most place names in the Vale come from it: *lume* (light) gives [[The Lume Bridge]] its name.\n\nThe [[Wardens of the Vale]] still swear their oaths in it.",
      "sources": []
    },
    {
      "id": "iron-circlet",
      "title": "The Iron Circlet",
      "category": "Artefacts",
      "body": "The crown of [[The Hollow Crown]]: a plain iron band, hollow inside, said to hold ash from [[Emberfall]].[^1] [[Aldric Vane]] wore it first; it was lost in [[The Shattering]].[^2]",
      "sources": [
        "Inventory of the Throne Hall",
        "Wren's tales (unreliable)"
      ]
    }
  ]
