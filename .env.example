# Copy to .env.local and fill in. Every setting is optional.

# ----- Accounts and cloud saving (Supabase) -----
# Leave these empty and the app saves in the browser only, with no sign-in.
# Set up: create a Supabase project, run supabase/schema.sql in its SQL Editor,
# then copy the Project URL and the publishable key (sb_publishable_…) from
# Settings → API Keys, or the project's Connect button. Never the secret key.
# The publishable key is meant to be public; row-level security keeps data private.
# (An older project's "anon" key works here too.)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Sign-in buttons besides email, e.g. google,github. Turn each on in
# Authentication → Providers first, and add this site's address under
# Authentication → URL Configuration (Site URL and Redirect URLs).
VITE_SUPABASE_PROVIDERS=

# ----- Branding (see src/brand.ts) -----
VITE_BRAND_NAME=
VITE_BRAND_TAGLINE=
VITE_BRAND_MARK=
VITE_BRAND_FOOTER=
VITE_DEFAULT_THEME=
VITE_SEED_URL=
VITE_PUBLISHED=
VITE_READ_ONLY=
VITE_DEMO_URL=
